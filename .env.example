# ─── Firebase (obtener en consola Firebase > Configuración del proyecto) ───
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=subzero-raspados.firebaseapp.com
FIREBASE_PROJECT_ID=subzero-raspados
FIREBASE_STORAGE_BUCKET=subzero-raspados.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ─── BAC Credomatic eCommerce (solicitar a BAC como comercio) ──────────────
BAC_MERCHANT_ID=
BAC_API_KEY=
BAC_API_SECRET=
BAC_ENVIRONMENT=sandbox      # sandbox | production
BAC_WEBHOOK_SECRET=

# ─── SendGrid (sendgrid.com > API Keys) ───────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=facturas@subzero.com
SENDGRID_FROM_NAME=Subzero Raspados

# ─── App ──────────────────────────────────────────────────────────────────
APP_URL=https://subzero-raspados.web.app
APP_ENV=development           # development | production
