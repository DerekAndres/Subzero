rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Productos — lectura pública, escritura solo usuarios autenticados
    match /productos/{docId} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // Extras — lectura pública, escritura solo usuarios autenticados
    match /extras/{docId} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // Pedidos
    match /pedidos/{pedidoId} {
      // Clientes crean sin login (efectivo o transferencia)
      allow create: if request.resource.data.keys().hasAll(["items","total","clienteEmail","estado"])
                    && request.resource.data.estado in ["PENDIENTE", "ESPERANDO_PAGO"];

      // Lectura individual por ID — cualquiera (link secreto para rastrear pedido)
      allow get:    if true;

      // Listar todos los pedidos — solo admin autenticado
      allow list:   if request.auth != null;

      // Actualizar (admin confirma, cambia estado)
      allow update: if request.auth != null;

      allow delete: if false;
    }

    // Admin users — solo lectura del propio documento
    match /admin_users/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
