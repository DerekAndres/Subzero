rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Productos — lectura pública, escritura solo usuarios autenticados
    match /productos/{docId} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // Extras — lectura pública, escritura solo usuarios autenticados
    match /extras/{docId} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // Pedidos — clientes crean sin login, admin lee y actualiza
    match /pedidos/{pedidoId} {
      allow create: if request.resource.data.keys().hasAll(["items","total","clienteEmail","estado"])
                    && request.resource.data.estado == "PENDIENTE";
      allow read:   if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Admin users — solo lectura del propio documento
    match /admin_users/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
